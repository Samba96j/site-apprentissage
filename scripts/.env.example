# LearnHub — configuration de l'import de la bibliothèque
#
# Copiez ce fichier en « .env » puis complétez les valeurs.
# ATTENTION : le fichier .env ne doit JAMAIS être commité (il est ignoré par git).

# Dossier du projet qui contient database.db et le dossier « pdf »
BIBLIO_SOURCE=C:\Users\MOYIZABA\Biblio_Numerique-Khelcom-Institut

# --- Cloudflare R2 ---------------------------------------------------------
# Tableau de bord Cloudflare → R2 → Manage API Tokens → Create API token
# (permission « Object Read & Write » sur le bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=learnhub-bibliotheque

# URL publique du bucket : domaine personnalisé, ou
# https://pub-xxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE=

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://achwmlisnsbyxcvwteam.supabase.co
SUPABASE_ANON_KEY=sb_publishable_h2IhiuomR_h_UwdJEM7XOg_m_i6dzhQ

# Compte autorisé à publier (enseignant ou super-administrateur)
ADMIN_EMAIL=
ADMIN_PASSWORD=
